// trufflecheck: shared static-analysis rules and strictness profiles for Elide's Truffle and GraalVM projects.
//
// Members, each building one JAR:
//   policy/      trufflecheck-policy      rule policy (owners, scopes, messages) shared by both checker JARs
//   errorprone/  trufflecheck-errorprone  Error Prone BugCheckers, policy included; a javac plugin
//   detekt/      trufflecheck-detekt      detekt rule set, policy included; a `detekt --plugins` JAR
// Tool profiles (Error Prone flags, detekt and CPD config, cargo-deny, clippy, Biome) live under `profiles/`.
amends "elide:project.pkl"

name = "trufflecheck"
version = "0.1.0" // x-release-please-version
description = "Static analysis rules and strictness profiles for Truffle implementations on GraalVM"

publishing {
  maven {
    groupId = "dev.elide"
    // `elide publish --to staging` (from the repository root) deploys a remote-layout repository under build/maven:
    // checksums and merged maven-metadata.xml. The release workflow seeds it with the live metadata, then uploads it
    // to the bucket behind https://maven.elide.dev. Relative `file:` URLs resolve against the cwd (runtime#3014).
    repositories {
      ["staging"] = "file:build/maven"
    }
    pom {
      name = "trufflecheck"
      description = "Static analysis rules for Truffle implementations targeting GraalVM Native Image"
      url = "https://github.com/elide-dev/trufflecheck"
      inceptionYear = "2026"
      licenses {
        new { name = "Apache-2.0"; url = "https://www.apache.org/licenses/LICENSE-2.0" }
        new { name = "MIT"; url = "https://opensource.org/licenses/MIT" }
      }
      organization {
        name = "Elide Technologies, Inc."
        url = "https://elide.dev"
      }
      scm {
        url = "https://github.com/elide-dev/trufflecheck"
        connection = "scm:git:https://github.com/elide-dev/trufflecheck.git"
      }
    }
  }
}

workspace {
  members {
    "policy"
    "errorprone"
    "detekt"
  }
}
